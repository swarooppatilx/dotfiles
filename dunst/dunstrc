# ~/.config/dunst/dunstrc
# Modern Catppuccin Mocha theme (fixed for icon warnings)

[global]
# Display
monitor = 0
follow = none

# Geometry
width = 300
height = (0, 100)
origin = top-right
offset = (10, 50)
scale = 0
notification_limit = 20
corner_radius = 8
corners = all
transparency = 10
frame_color = "#89b4fa"
separator_color = frame
highlight = "#89b4fa"
frame_width = 2
separator_height = 2
gap_size = 4
padding = 10
horizontal_padding = 14
text_icon_padding = 6

# Progress bar
progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 1
progress_bar_min_width = 150
progress_bar_max_width = 300
progress_bar_corner_radius = 4
progress_bar_corners = all

# Text
font = "JetBrains Mono 11"
line_height = 0
markup = full
format = "<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
ellipsize = middle
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false
show_indicators = yes

# Icons
enable_recursive_icon_lookup = true
icon_theme = Adwaita          # Only installed theme, no warnings
icon_position = left
min_icon_size = 32
max_icon_size = 128
icon_corner_radius = 6
icon_corners = all
icon_path = /usr/share/icons/Adwaita/16x16/status/:/usr/share/pixmaps/:~/.icons/

# History
sticky_history = yes
history_length = 20

# Misc
dmenu = /usr/bin/dmenu -p dunst:
browser = /usr/bin/xdg-open
always_run_script = true
title = Dunst
class = Dunst
ignore_dbusclose = false

# Mouse actions
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[experimental]
per_monitor_dpi = false

# Urgency colors
[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"
timeout = 10
default_icon = dialog-information

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"
timeout = 10
default_icon = dialog-information

[urgency_critical]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#fab387"
timeout = 0
default_icon = dialog-warning

# Common apps fallback icons
[flameshot]
appname = Flameshot
default_icon = flameshot

[discord]
appname = Discord
default_icon = discord

[firefox]
appname = Firefox
default_icon = firefox

[terminal]
appname = Alacritty
default_icon = terminal
